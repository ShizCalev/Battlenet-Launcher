#include <winres.h>
#include "version.h"

A ICON MOVEABLE PURE LOADONCALL DISCARDABLE "ico.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION VERSION_MAJOR, VERSION_MINOR, VERSION_PATCH, VERSION_CI_BUILD
PRODUCTVERSION VERSION_MAJOR, VERSION_MINOR, VERSION_PATCH, VERSION_CI_BUILD
FILETYPE VFT_APP
{
	BLOCK "StringFileInfo"
	{
		BLOCK "040904E4"
		{
			VALUE "CompanyName", COMPANY_NAME
			VALUE "FileVersion", FILE_VERSION
			VALUE "FileDescription", FILE_DESCRIPTION
			VALUE "InternalName", INTERNAL_NAME
			VALUE "LegalCopyright", LEGAL_COPYRIGHT
			VALUE "LegalTrademarks", LEGAL_TRADEMARKS
			VALUE "OriginalFilename", ORIGINAL_FILENAME
			VALUE "ProductName", PRODUCT_NAME
			VALUE "ProductVersion", PRODUCT_VERSION
		}
	}

	BLOCK "VarFileInfo"
	{
		VALUE "Translation", 0x0409, 1252
	}
}
